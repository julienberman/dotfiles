[core]
    pager = delta
    editor = nvim

[user]
    email = julien.d.berman@gmail.com
    name = Julien Berman
    signingkey = ~/.ssh/id_ed25519.pub

[init]
    defaultBranch = main

[commit]
    gpgsign = true

[push]
    autoSetupRemote = true
    default = current

[alias]
    undo = reset --soft HEAD^

[gpg]
    format = ssh

[delta]
    line-numbers = true

[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true

