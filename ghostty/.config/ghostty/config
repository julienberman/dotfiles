
# style
theme = catppuccin-mocha.conf
font-family = CaskaydiaCove Nerd Font
background-opacity = 1
font-size = 14
cursor-style = block
adjust-cell-height = 35%
title = " "
window-padding-x = 5
window-padding-y = 0
window-save-state = always
macos-titlebar-style = transparent
confirm-close-surface = false
shell-integration-features = ssh-terminfo, ssh-env, no-cursor

# Notifications
app-notifications = no-clipboard-copy 

# Keybindings
keybind = shift+enter=text:\x1b[13;2u
keybind = ctrl+backspace=text:\x17
keybind = ctrl+tab=text:\x1b[27;5;9~
keybind = ctrl+shift+tab=text:\x1b[27;6;9~
keybind = ctrl+1=csi:49;5u
keybind = ctrl+2=csi:50;5u
keybind = ctrl+3=csi:51;5u
keybind = ctrl+4=csi:52;5u
keybind = ctrl+5=csi:53;5u
keybind = ctrl+6=csi:54;5u
keybind = ctrl+7=csi:55;5u
keybind = ctrl+8=csi:56;5u
keybind = ctrl+9=csi:57;5u
