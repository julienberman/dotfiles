{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin-macchiato"
  },
  "keybinds": {
    "leader": "ctrl+o",
    "model.cycle_favorite": "<leader>f",
    "input.submit": "return",
    "input.newline": "shift+return,ctrl+j",
    "agent.cycle": "tab"
  },
  "scroll": {
    "speed": 1
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "plugins": ["./herdr-opencode"]
}
