{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "plan",
    "permission": {
        "read": {
            "*": "allow",
            "*.env": "deny",
            "*.env.*": "deny",
            "*.env.example": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
    },
    "mcp": {
        // Fetches up-to-date docs for popular libraries
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        // Gets components
        "shadcn": {
            "type": "local",
            "command": ["pnpm", "dlx", "shadcn@latest", "mcp"],
            "enabled": true
        },
        // Handles Railway deployments
        "railway": {
            "type": "local",
            "command": ["railway", "mcp"],
            "enabled": true
        },
        "snowflake": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_5p7ZEYG4iuMhd4nhCrgLnB/mcp",
            "enabled": true,
            "oauth": false,
            "headers": {
                "Authorization": "Bearer gkey_08CwyeUoB8u4tCdiHXAE6v:UhkMf7nJ4IpbTvlKK3j6w7lc2UTNkmahi9-mF0OdeKY"
            }
        }
    }
}
