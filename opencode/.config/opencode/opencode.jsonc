{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  // ------ THEME ------
  "theme": "catppuccin-macchiato",
  // ------ AGENTS -----
  "default_agent": "plan",
  // ------ KEYBINDS -----
  "keybinds": {
    "input_submit": "ctrl+enter"
  },
  // ------ INSTRUCTIONS ------
  "instructions": [
    "rules/general.md",
    "rules/python.md",
    "rules/R.md"
  ]
}
