{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "plan",
    "permission": {
        "webfetch": "allow",
        "websearch": "allow"
    },
    "mcp": {
        // Fetches up-to-date docs for popular libraries
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        // Gets components
        "shadcn": {
            "type": "local",
            "command": ["pnpm", "dlx", "shadcn@latest", "mcp"],
            "enabled": true
        }
    }
}
