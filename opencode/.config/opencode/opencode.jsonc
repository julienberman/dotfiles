{
    "$schema": "https://opencode.ai/config.json",
    "autoupdate": true,
    "default_agent": "plan",
    "permission": {
        "read": {
            "*": "allow"
        },
        "external_directory": {
            "*": "ask",
            "~/Documents/**": "allow",
            "~/.herdr/worktrees/**": "allow",
            "~/.config/opencode/skills/**": "allow"
        },
        "webfetch": "allow",
        "websearch": "allow"
    },
    "plugin": [
        ["@plannotator/opencode@latest", {
            "workflow": "manual",
            "planningAgents": ["plan", "sisyphus"]
        }]
    ],
    "mcp": {
        // Fetches up-to-date docs for popular libraries
        "context7": {
            "type": "remote",
            "url": "https://mcp.context7.com/mcp",
            "enabled": true
        },
        // Gets components
        "shadcn": {
            "type": "local",
            "command": ["pnpm", "dlx", "shadcn@latest", "mcp"],
            "enabled": true
        },
        // Handles Railway deployments
        "railway": {
            "type": "remote",
            "url": "https://mcp.railway.com",
            "enabled": true
        },
        // Handles session logs
        "datadog": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_06B4geqJvwSnXvAXeaoZEF/mcp",
            "enabled": true
        },
        // Handles snowflake data
        "snowflake": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_5p7ZEYG4iuMhd4nhCrgLnB/mcp",
            "enabled": true
        },
        // Handles dashboards
        "metabase": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_6NcVquHm8oyTDaJlrTuUKI/mcp",
            "enabled": true
        },
        // Feature flags
        "launch_darkly": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_1V0uw7wkif6sdGY0qlCwiU/mcp",
            "enabled": true
        },
        "semaphore": {
            "type": "remote",
            "url": "https://app.mintmcp.com/s/g_6H2LhqCE3rSMnYqwhBK1by/mcp",
            "enabled": true
        }
    }
}
